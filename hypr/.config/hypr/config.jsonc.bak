{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces",
    "custom/sep",
    "hyprland/submap",
    "custom/sep",
    "hyprland/window"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "mpris",
    "privacy",
//    "keyboard-state",
    "custom/sep",
    "custom/mic",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "battery",
    "custom/sep",
    "network",
    "custom/sep",
    "temperature",
    "custom/sep",
    "cpu",
    "custom/sep",
    "memory",
    "custom/sep",
    "disk",
    "custom/sep",
    "clock",
    "custom/sep",
    "tray"
  ],
  "mpris": {
    "format": "{player_icon} [  ]",              // playing
    "format-paused": "[  ]",       // paused
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "{volume}% 󰖁",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "tooltip": true,
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "on-click": "pamixer -t"
  },
  "custom/mic": {
    "format": "{}",
    "exec": "sh -c 'muted=$(pamixer --default-source --get-mute); vol=$(pamixer --default-source --get-volume); if [ \"$muted\" = \"true\" ]; then echo \"${vol}% \"; else echo \"${vol}% \"; fi'",
    "interval": 2,
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source -i 5",
    "on-scroll-down": "pamixer --default-source -d 5",
    "tooltip": "Mic (click: mute, scroll: volume)"
  },
  "privacy": {
      "icon-spacing": 4,
      "icon-size": 12,
      "modules": [
          { "type": "screenshare", "tooltip": true },
          { "type": "audio-out",   "tooltip": true },
          { "type": "audio-in",    "tooltip": true }
      ]
},
  "temperature": {
    "thermal-zone": 0,      // try 0, 1, 2 if unsure
    "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
    "format": "{temperatureC}°C",
    "critical-threshold": 80
  },
"keyboard-state": {
  "format": "{icon}",
  "capslock": true,
  "numlock": true,
  "scrolllock": false
},
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}",
    "format-alt": "{:%a %m/%d/%y %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n{calendar}"
  },
  "cpu": {
    "format": "{usage}% ",
    "interval": 5,
    "tooltip": true,
    "on-click": "alacritty -e cpu-auto"
  },
  "memory": {
    // "format": "{used:.1f}<small> GiB</small> ",
    "format": "{used:.1f}<small> GiB</small> ",
    "interval": 5,
    "tooltip": true,
    "on-click": "alacritty -e btop"
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "{free} 󰋊",
    "on-click": "xdg-open ~"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-icons": ["", "", "", "", ""]
  },
  "network": {
    "format": "Online",
    "format-disconnected": "Disconnected ⚠"
  },
  "hyprland/workspaces": {
      "format": "{id}",
      "sort-by": "number",
      "all-outputs": false,
      "persistent-workspaces": {
          "*": [1,2,3,4,5,6,7,8,9]
      },
      "ignore-workspaces": ["^99$"]
  },
  "hyprland/submap": {
    "format": "{}",
    "always-on": true,
    "default-submap": "[]=",
    "tooltip": false
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  }
}
