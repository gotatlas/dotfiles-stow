{
    "layer": "top",
    "position": "bottom",
    "height": 18,
    //"exclusive": true,
    //"fixed-center": false,
    "modules-left": [],
    "modules-center": [
      "wlr/taskbar"
    ],
    "modules-right": [],
    "wlr/taskbar": {
        "format": "{title}",
        "tooltip-format": "{app_id}\n{title}",
        "all-outputs": false,

        "active-first": false,
        "sort-by-app-id": false,

        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize-raise"
    }
}
