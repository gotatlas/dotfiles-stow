#!/usr/bin/env bash
set -euo pipefail

# Get "clients" and 0-based focused index for the active tag.
#
# Expected line from `mmsg -g -t` looks roughly like:
#   eDP-1 tag 1 1 4 2
#               ^ ^ ^
#               | | |
#               | | +-- focused index (0- or 1-based)
#               | +---- client count
#               +------ active flag (1 = current tag)
#
# We:
#   - pick the active tag line ($4 == 1)
#   - read $5 (clients), $6 (focused_raw)
#   - normalize focused_raw to 0-based idx

line="$(mmsg -g -t | awk '/ tag / && $4 == 1 { print $5, $6; exit }')"

if [ -z "$line" ]; then
    echo "0 0"
    exit 0
fi

set -- $line
clients="$1"
focused_raw="$2"

if [ "$clients" -le 0 ]; then
    echo "0 0"
    exit 0
fi

# Heuristic: if focused_raw >= clients, treat it as 1-based; else 0-based.
if [ "$focused_raw" -ge "$clients" ]; then
    idx0=$((focused_raw - 1))
else
    idx0=$focused_raw
fi

echo "$clients $idx0"
