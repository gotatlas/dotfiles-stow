#!/usr/bin/env bash
set -euo pipefail

clients=$(./current-tag-clients)
[ -z "$clients" ] && exit 0
[ "$clients" -le 1 ] && exit 0

# 1) Find minimal x (master area)
min_x=999999
i=0
while [ "$i" -lt "$clients" ]; do
    x=$(mmsg -x | awk '{print $1}')
    if [ "$x" -lt "$min_x" ]; then
        min_x="$x"
    fi
    mmsg -d focusstack,next
    i=$((i+1))
done
# Now we're back at original focus; min_x is known.

# 2) Move to the next window that is not in the master column
i=0
while [ "$i" -lt "$clients" ]; do
    mmsg -d focusstack,next
    x=$(mmsg -x | awk '{print $1}')
    # any x > min_x is considered "stack"
    if [ "$x" -gt "$min_x" ]; then
        break
    fi
    i=$((i+1))
done
# If there is no stack (all x == min_x), we end up where we started. Harmless.
