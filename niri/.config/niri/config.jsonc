{
  "layer": "top",
  "position": "top",
  "height": 10,
  "modules-left": [
    "niri/workspaces",
    // "custom/sep",
    "niri/window"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "privacy",
    "tray",
    // "mpris",
    "custom/sep",
    //"custom/sep",
    "custom/mic",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "battery",
    "custom/sep",
    "network",
    "custom/sep",
    "temperature",
    "custom/sep",
    "cpu",
    "custom/sep",
    "memory",
    "custom/sep",
    "disk",
    "custom/sep",
    "clock"
    // "custom/sep",
  ],
  "niri/workspaces": {
    "all-outputs": true
  },
  "tray": {
    "icon-size": 11,
    "spacing": 2
  },
  "mpris": {
    "format": "[  ]",              // playing
    "format-paused": "[  ]",       // paused
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "{volume}% 󰝟",
    "format-icons": ["", "", ""],
    "tooltip": true,
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "on-click": "pamixer -t"
  },
  "custom/mic": {
    "format": "{}",
    "exec": "sh -c 'muted=$(pamixer --default-source --get-mute); vol=$(pamixer --default-source --get-volume); if [ \"$muted\" = \"true\" ]; then echo \"${vol}% \"; else echo \"${vol}% \"; fi'",
    "interval": 2,
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source -i 5",
    "on-scroll-down": "pamixer --default-source -d 5",
    "tooltip": "Mic (click: mute, scroll: volume)"
  },
  "privacy": {
      "icon-spacing": 8,
      "icon-size": 12,
      "modules": [
          { "type": "screenshare", "tooltip": true },
          { "type": "audio-out",   "tooltip": true },
          { "type": "audio-in",    "tooltip": true }
      ]
},
  "temperature": {
    "thermal-zone": 0,      // try 0, 1, 2 if unsure
    "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
    "format": "{temperatureC}°C",
    "critical-threshold": 80
  },
  "keyboard-state": {
    "format": "{icon}",
    "capslock": true,
    "numlock": true,
    "scrolllock": false
  },
  "clock": {
    "format": "{:%a %m-%d-%y %H:%M}",
    "format-alt": "{:%a %m-%d-%y %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n{calendar}"
  },
  "cpu": {
    "format": "{usage}%",
    "interval": 5,
    "tooltip": true,
    //"on-click": "alacritty -e cpu-auto"
  },
  "memory": {
    "format": "{used}GiB",
    "interval": 5,
    "tooltip": true,
    "on-click": "alacritty -e btop"
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "{free}",
    "on-click": "thunar ~"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 20,
      "critical": 10
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-icons": ["", "", "", "", ""]
  },
  "network": {
    "format": "Online",
    "format-disconnected": "Disconnected"
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": false,
    "on-click": "activate",
    "sort-by-id": true
  },
  "dwl/tags": {
    "num-tags": 9
  },
  "dwl/window#layout": {
    "format": "[{layout}]"
  },
  "dwl/window#title": {
    "format": "{title}"
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  }
}
